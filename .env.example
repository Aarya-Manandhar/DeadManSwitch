# Dead Man's Switch — Environment Variables
# Copy this file to .env and fill in your keys.

# Pinata API JWT for IPFS uploads
# Get one at https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=your_pinata_jwt_here

# Pinata Gateway for fast retrieval (Optional)
# e.g., https://gateway.pinata.cloud
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional: Pimlico API key for gas-sponsored (Paymaster) transactions
# Get one free at https://dashboard.pimlico.io
# Without this, users pay gas normally with Sepolia ETH
VITE_PIMLICO_API_KEY=your_pimlico_api_key_here
